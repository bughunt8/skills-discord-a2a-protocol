  "from": "123456789012345678",
  "channel_id": "111222333444555666",
  "trace_id": "aabbccdd-1234-5678-abcd-ef0123456789",
  "payload": {
    "jsonrpc": "2.0",
    // No "id" field — Notification pattern
    "method": "da2a.task.progress",
