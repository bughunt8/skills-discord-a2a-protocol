{
  // ==========================================================================
  // DA2A-HO — discord-permissions.jsonc
  // Version: 1.3.1
  //
  // Minimum Discord bot/OAuth2 permissions required by each DA2A role.
  // Harness implementations SHOULD request ONLY these scopes.
  // ==========================================================================
  "note": "All timestamp, channel_id, and author metadata referenced in DA2A-HO are read from the Discord message object already delivered by the gateway — no extra scopes required for those fields.",

  "roles": {
    "orchestrator": {
      "description":    "Initiates sessions, holds the initial baton, manages admission, broadcasts policy.",
      "gateway_intents": ["GUILD_MESSAGES","MESSAGE_CONTENT","DIRECT_MESSAGES","GUILD_MEMBERS"],
      "rest_permissions": ["SEND_MESSAGES","READ_MESSAGE_HISTORY","CREATE_PUBLIC_THREADS","MANAGE_THREADS","EMBED_LINKS","ATTACH_FILES"],
      "oauth2_scopes":  ["bot","messages.read"]
    },
    "specialist": {
      "description":    "Receives baton by transfer, performs sub-tasks, returns results.",
      "gateway_intents": ["GUILD_MESSAGES","MESSAGE_CONTENT","DIRECT_MESSAGES"],
      "rest_permissions": ["SEND_MESSAGES","READ_MESSAGE_HISTORY","EMBED_LINKS","ATTACH_FILES"],
      "oauth2_scopes":  ["bot","messages.read"]
    },
    "observer": {
      "description":    "Monitoring only; DENIED or PENDING_ADMISSION state; MUST NOT transmit.",
      "gateway_intents": ["GUILD_MESSAGES","MESSAGE_CONTENT"],
      "rest_permissions": ["READ_MESSAGE_HISTORY"],
      "oauth2_scopes":  ["bot","messages.read"]
    }
  },

  "attachment_escalation": {
    "trigger_chars":     1800,
    "discord_limit_mb":  25,
    "external_trigger_bytes": 26214400,
    "note": "Payloads >1800 chars SHOULD be sent as Discord attachments. Payloads >25 MB SHOULD use an external artifact store. External stores are optional for smaller payloads."
  }
}
