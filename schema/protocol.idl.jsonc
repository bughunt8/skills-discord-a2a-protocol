{
  // ===========================================================================
  // DA2A-HO — Discord Agent-to-Agent High-Efficiency Operations Protocol
  // schema/protocol.idl.jsonc
  //
  // Version   : 1.3.1
  // License   : MIT
  // Repo      : github.com/bughunt8/skills-discord-a2a-protocol
  //
  // Architecture: ISO-style 3-layer stack
  //   Layer 1 — Accessing   : Medium access discipline (IEEE 802.11 CSMA/CA inspired)
  //   Layer 2 — Talking     : Encoded packet transfer between agents
  //   Layer 3 — Assimilation: Local KV-cache and context update from received data
  //
  // Normative language follows RFC 2119: MUST / SHOULD / MAY.
  // ===========================================================================

  "meta": {
    "protocol":     "DA2A-HO",
    "version":      "1.3.1",
    "architecture": "ISO-style 3-layer",
    "transport":    "Discord-native first; envelope metadata as control supplement",
    "primary_goal": "Maximize semantic payload per token across: LLM-decode → Discord-transport → LLM-encode",
    "efficiency_pillars": ["token","payload","cognitive","turn","reliability","observability"]
  },

  // ---------------------------------------------------------------------------
  // SECTION 1 — Primitive Types
  // ---------------------------------------------------------------------------
  "types": {
    "AgentId":          "string",   // e.g. "agent.openclaw"
    "HumanId":          "string",
    "ChannelId":        "string",   // Discord channel / thread / DM identifier
    "ConversationHash": "string",   // Unique baton hash — 1 per channel at any time
    "PacketId":         "string",   // Per-packet UUID or slug
    "Sha256":           "string",   // "sha256:<hex>"

    // NOTE: timestamp, channel_id, author/from, to, and delivery_mode are ALL
    // provided by the Discord message object natively and MUST NOT be duplicated
    // inside DA2A-HO packet payloads. See L2TalkHeader for the boundary.

    "PacketTheme": [
      "human_readable",   // default — "[DA2A-HO pkt=N conv=X ...]" compact text header
      "compact_json"      // machine-first opcode arrays; negotiated between agents
    ],
    "AccessMode": [
      "listen",    // observing medium — no transmission permitted
      "contend",   // ready to transmit; waiting for clear medium
      "transmit",  // actively sending; baton held
      "backoff",   // post-collision or ALL_STOP randomized wait
      "override"   // human operator has seized baton
    ],
    "ProtocolState": [
      "IDLE","OPENING","ACTIVE","DEGRADED_SIGNAL",
      "COLLISION_BACKOFF","HUMAN_OVERRIDE","CLOSED"
    ],
    "PacketIntent": [
      "open","close",
      "handoff","ask","result","status",
      "ack","nack","heartbeat",
      "memory_proxy_request","memory_proxy_response",
      "cache_ref",
      "all_stop","resume",
      "artifact_announce","roster_update"
    ],
    // DeliveryMode is harness-only — implicit from Discord message type (DM / reply /
    // thread / mention). It is NOT carried inside any DA2A-HO packet payload.
    // See transport_constraints.addressing_precedence for harness selection order.
    "AckCode": ["ok","duplicate","hash_mismatch","out_of_order","unsupported","busy"],
    "StorageBackend": ["discord_attachment","cloudflare_r2","aws_s3","minio"],
    "ArtifactRole":   ["artifact","whiteboard","replay_bundle","cache_ref","vocabulary","roster"],
    "JoinMode":       ["none","direct_update_required"]
  },

  // ---------------------------------------------------------------------------
  // SECTION 2 — Layer 1 Structs (Accessing)
  // ---------------------------------------------------------------------------
  "layer_1_structs": {

    // One channel MUST have exactly ONE ConversationBaton at any time.
    "ConversationBaton": {
      "channel_id":        "ChannelId",
      "conversation_hash": "ConversationHash",
      "holder":            "AgentId|HumanId",
      "created_by":        "AgentId|HumanId",
      "created_at":        "string",   // ISO-8601 — set by harness from Discord message.timestamp
      "ttl_seconds":       "number|null"
    },

    // Observable medium state assessed before transmitting.
    "AccessObservation": {
      "channel_id":               "ChannelId",
      "presence_visible":         "boolean|null",
      "recent_activity_detected": "boolean",
      "reply_chain_active":       "boolean",
      "thread_active":            "boolean",
      "medium_busy":              "boolean",
      "recommended_mode":         "AccessMode"
    },

    "L1AccessHeader": {
      "channel_id":         "ChannelId",
      "conversation_hash":  "ConversationHash",
      "protocol_state":     "ProtocolState",
      "access_observation": "AccessObservation",
      "baton":              "ConversationBaton"
    },

    "BatonControl": {
      "action": ["hold","transfer","request","take","release"],
      "from":   "AgentId|HumanId",
      "to":     "AgentId|HumanId|null",
      "reason": "string|null"
    },

    "BackoffConfig": {
      "min_ms":                "number",
      "max_ms":                "number",
      "jitter":                "boolean",
      "cancel_pending_replies": "boolean"
    }
  },

  // ---------------------------------------------------------------------------
  // SECTION 3 — Layer 2 Structs (Talking)
  // ---------------------------------------------------------------------------
  "layer_2_structs": {

    // -------------------------------------------------------------------------
    // L2TalkHeader — DA2A-HO packet envelope
    //
    // DISCORD-NATIVE FIELDS — provided by Discord; MUST NOT be duplicated here:
    //   timestamp     → Discord message.timestamp  (Snowflake; ms precision)
    //   channel_id    → Discord message.channel_id
    //   from / author → Discord message.author.id
    //   to            → Discord DM target or @mention; harness sets before send
    //   delivery_mode → implicit from Discord message type (DM/reply/thread/mention)
    //
    // DA2A-HO carries ONLY what Discord does not already provide.
    // -------------------------------------------------------------------------
    "L2TalkHeader": {
      "packet_id":    "PacketId",       // DA2A correlation ID — NOT the Discord message ID
      "seq":          "number",         // Monotonic per-conversation sequence counter
      "intent":       "PacketIntent",
      "theme":        "PacketTheme",
      "reply_to":     "PacketId|null",  // DA2A-level thread correlation
      "ack":          "AckState|null",
      "content_hash": "Sha256|null"     // SHA-256 of serialized payload (Discord does not provide)
    },

    "AckState": {
      "ack_for": "PacketId",
      "code":    "AckCode",
      "detail":  "string|null"
    },

    // Primary payload for handoff / ask / result.
    // Agents MUST send deltas — never full transcript replay.
    "StateDelta": {
      "goal":               "string|null",
      "phase":              "string|null",
      "decision_delta":     "string[]",
      "constraints":        "string[]",
      "open_questions":     "string[]",
      "requested_action":   "string|null",
      "max_response_chars": "number|null"
    },

    // Memory proxy — agents MUST use this; direct remote memory mounts are FORBIDDEN.
    "MemoryProxyRequest": {
      "query":              "string",
      "max_items":          "number",
      "summary_only":       "boolean",
      "include_source_ids": "boolean",
      "exclude_private":    "boolean"
    },
    "MemoryProxyResponse": {
      "summary":     "string[]",
      "source_refs": "string[]",
      "confidence":  "number"    // 0.0–1.0
    },

    // KV-cache reference — raw KV tensors MUST NOT be transmitted over Discord.
    "KvCacheReference": {
      "cache_id":               "string",
      "owner":                  "AgentId",
      "model_family":           "string",
      "compatibility":          "string",   // "metadata_only" | "binary_compatible" | "none"
      "uri":                    "string|null",
      "sha256":                 "Sha256|null",
      "fallback_text_required": "boolean"
    },

    "ChannelQuality": {
      "latency_ms_avg":    "number",
      "message_loss_rate": "number",
      "duplicate_rate":    "number",
      "parse_error_rate":  "number",
      "out_of_order_count":"number",
      "rate_limit_events": "number",
      "confidence":        "number"
    }
  },

  // ---------------------------------------------------------------------------
  // SECTION 4 — Layer 3 Structs (Assimilation)
  // ---------------------------------------------------------------------------
  "layer_3_structs": {

    "L3AssimilationHeader": {
      "local_cache_update": "boolean",
      "evict_on_close":     "boolean",
      "compression_hint":   ["none","lz4","zstd"],
      "encoding_layers":    "number"   // 1=human text, 2=compact_json, 3=binary
    },

    "RemoteMemoryRecord": {
      "source_agent": "AgentId",
      "summary":      "string",
      "source_ids":   "string[]",
      "confidence":   "number",
      "evict_at":     "string|null"
    },

    "WhiteboardRecord": {
      "artifact_id":    "string",
      "role":           "ArtifactRole",
      "uri":            "string",
      "sha256":         "Sha256",
      "retrieved_at":   "string",   // ISO-8601; set by harness at retrieval time
      "evict_on_close": "boolean"
    }
  },

  // ---------------------------------------------------------------------------
  // SECTION 5 — Composite Packet
  // ---------------------------------------------------------------------------
  "ThreeLayerPacket": {
    "l1":      "L1AccessHeader",
    "l2":      "L2TalkHeader",
    "l3":      "L3AssimilationHeader",
    "payload": "StateDelta | MemoryProxyRequest | MemoryProxyResponse | KvCacheReference | ArtifactAnnouncement | BatonControl | BackoffConfig | null",

    // discord_message_id: optional audit/replay field only.
    // timestamp, channel_id, from, to are provided by Discord — not repeated here.
    "discord_message_id": "string|null"
  },

  // ---------------------------------------------------------------------------
  // SECTION 6 — Artifact Announcement
  // ---------------------------------------------------------------------------
  "ArtifactAnnouncement": {
    "artifact_id":     "string",
    "role":            "ArtifactRole",
    "uri":             "string",
    "backend":         "StorageBackend",
    "sha256":          "Sha256",
    "size_bytes":      "number",
    "mime_type":       "string",
    "ttl_seconds":     "number|null",
    "fallback_inline": "string|null"
  },

  // ---------------------------------------------------------------------------
  // SECTION 7 — RPC Methods
  // ---------------------------------------------------------------------------
  "interfaces": {
    "access": [
      "access.baton.claim",
      "access.baton.transfer",
      "access.baton.request",
      "access.baton.take",
      "access.baton.release",
      "access.all_stop",
      "access.resume",
      "access.heartbeat"
    ],
    "talk": [
      "talk.open",
      "talk.close",
      "talk.handoff",
      "talk.ask",
      "talk.result",
      "talk.status",
      "talk.ack",
      "talk.nack",
      "talk.memory.proxy_request",
      "talk.memory.proxy_response",
      "talk.cache.ref",
      "talk.artifact.announce",
      "talk.roster.update"
    ],
    "assimilate": [
      "assimilate.memory_record",
      "assimilate.whiteboard_record",
      "assimilate.evict",
      "assimilate.recover_from_whiteboard"
    ]
  },

  // ---------------------------------------------------------------------------
  // SECTION 8 — Protocol State Machine
  // ---------------------------------------------------------------------------
  "state_machine": {
    "states": [
      "IDLE","OPENING","ACTIVE","DEGRADED_SIGNAL",
      "COLLISION_BACKOFF","HUMAN_OVERRIDE","CLOSED"
    ],
    "transitions": [
      { "from": "IDLE",              "to": "OPENING",           "trigger": "access.baton.claim" },
      { "from": "OPENING",           "to": "ACTIVE",            "trigger": "talk.open + ack received" },
      { "from": "ACTIVE",            "to": "DEGRADED_SIGNAL",   "trigger": "ChannelQuality confidence < 0.5" },
      { "from": "ACTIVE",            "to": "COLLISION_BACKOFF", "trigger": "access.all_stop" },
      { "from": "ACTIVE",            "to": "HUMAN_OVERRIDE",    "trigger": "access.baton.take (human)" },
      { "from": "DEGRADED_SIGNAL",   "to": "ACTIVE",            "trigger": "quality recovered" },
      { "from": "DEGRADED_SIGNAL",   "to": "COLLISION_BACKOFF", "trigger": "parse_error_rate > threshold" },
      { "from": "COLLISION_BACKOFF", "to": "ACTIVE",            "trigger": "access.resume after backoff" },
      { "from": "HUMAN_OVERRIDE",    "to": "ACTIVE",            "trigger": "human releases baton" },
      { "from": "HUMAN_OVERRIDE",    "to": "CLOSED",            "trigger": "human issues close" },
      { "from": "ACTIVE",            "to": "CLOSED",            "trigger": "talk.close acknowledged" }
    ]
  },

  // ---------------------------------------------------------------------------
  // SECTION 9 — Transport Constraints
  // ---------------------------------------------------------------------------
  "transport_constraints": {
    "discord_message_limit_chars":        2000,
    "discord_nitro_limit_chars":          4000,
    "discord_attachment_limit_mb":        25,
    "escalation_to_attachment_chars":     1800,
    "escalation_to_external_store_bytes": 26214400,

    // Harness delivery selection order — NOT carried inside the DA2A packet.
    // Discord message type is the delivery record; this array guides harness behaviour only.
    "addressing_precedence": [
      "discord_dm",      // 1st: private unicast
      "discord_reply",   // 2nd: in-thread correlation
      "discord_thread",  // 3rd: topic isolation
      "discord_mention", // 4th: soft notification
      "envelope_only"    // 5th: control-plane fallback
    ],

    "normative_rules": [
      "Implementations SHOULD use Discord-native DM, reply, and thread as the primary delivery substrate.",
      "Implementations SHOULD prefer compact state deltas, hashes, and references over transcript replay.",
      "Implementations MAY use external object storage for artifacts exceeding Discord limits or requiring durable multi-session retrieval.",
      "Implementations MUST NOT assume direct remote memory mounting between agent runtimes over Discord transport."
    ]
  }
}
